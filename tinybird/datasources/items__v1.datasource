SCHEMA >
    `tenant_id` String `json:$.tenant_id`,
    `catalog_id` String `json:$.catalog_id`,
    `item_id` String `json:$.item_id`,
    `title` String `json:$.title`,
    `description` Nullable(String) `json:$.description`,
    `tags` Array(String) `json:$.tags[:]`,
    `category` Nullable(String) `json:$.category`,
    `image_url` Nullable(String) `json:$.image_url`,
    `price` Nullable(Float64) `json:$.price`,
    `attributes` String `json:$.attributes`,
    `created_at` Int64 `json:$.created_at`,
    `updated_at` Int64 `json:$.updated_at`

ENGINE "MergeTree"
ENGINE_SORTING_KEY "tenant_id,catalog_id,created_at,item_id"

{
  "name": "lumin",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "tb:generate": "tinykit generate --file src/validation/tinybird-schemas.ts --file src/lib/tinybird-pipes.ts",
    "tb:push": "tinykit deploy --allow-destructive-operations",
    "tb:deploy": "bun run tb:generate && bun run tb:push",
    "auth:generate": "bun x @better-auth/cli generate",
    "auth:migrate": "bun x @better-auth/cli migrate",
    "seed": "curl -X POST http://localhost:8787/api/admin/seed"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.6.18",
    "@upstash/vector": "^1.2.3",
    "@vyr-e/tinykit": "0.1.5",
    "better-auth": "^1.6.18",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.39.3",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.12.25",
    "hono-rate-limiter": "^0.4.2",
    "mathjs": "^14.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260613.1",
    "@types/dotenv": "^8.2.3",
    "@types/node": "^24.13.2",
    "@vitest/coverage-v8": "^3.2.6",
    "drizzle-kit": "0.30.6",
    "tsx": "^4.22.4",
    "vitest": "^3.2.6",
    "wrangler": "^4.100.0"
  }
}
